---
import Logo from "@/Logo.astro";
import { Github, Twitter, Heart } from "lucide-react";

export interface Props {
    className?: string;
}

const { className = "" } = Astro.props;
---

<footer
    class={`border-t bg-[radial-gradient(ellipse_1200px_800px_at_50%_0%,rgba(59,130,246,0.2)_0%,rgba(59,130,246,0.1)_40%,rgba(59,130,246,0.01)_70%,transparent_100%)] dark:bg-[radial-gradient(ellipse_1200px_800px_at_50%_0%,rgba(59,130,246,0.15)_0%,rgba(59,130,246,0.08)_40%,rgba(59,130,246,0.02)_70%,transparent_100%)] transition-all duration-200 ${className}`}
>
    <div class="container mx-auto px-4 py-12">
        <div class="grid md:grid-cols-4 gap-8">
            <!-- Logo & Description -->
            <div class="md:col-span-2">
                <Logo />
                <p class="text-muted-foreground max-w-md mb-6 mt-5">
                    The modern content management system built for developers
                    who want power and simplicity. Inspired by Filament v3,
                    powered by modern web technologies.
                </p>
                <div class="flex space-x-4">
                    <a
                        href="https://github.com/excalibur-cms"
                        class="p-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-muted-foreground hover:text-white transition-colors"
                        aria-label="GitHub"
                    >
                        <Github className="w-5 h-5" />
                    </a>
                    <a
                        href="https://twitter.com/excalibur_cms"
                        class="p-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-muted-foreground hover:text-white transition-colors"
                        aria-label="Twitter"
                    >
                        <Twitter className="w-5 h-5" />
                    </a>
                </div>
            </div>

            <!-- Documentation -->
            <div>
                <h3 class="font-semibold mb-4">Documentation</h3>
                <ul class="space-y-2">
                    <li>
                        <a
                            href="/docs/getting-started"
                            class="text-muted-foreground hover:text-white transition-colors"
                            >Getting Started</a
                        >
                    </li>
                    <li>
                        <a
                            href="/docs/installation"
                            class="text-muted-foreground hover:text-white transition-colors"
                            >Installation</a
                        >
                    </li>
                    <li>
                        <a
                            href="/docs/components"
                            class="text-muted-foreground hover:text-white transition-colors"
                            >Components</a
                        >
                    </li>
                    <li>
                        <a
                            href="/docs/api"
                            class="text-muted-foreground hover:text-white transition-colors"
                            >API Reference</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Community -->
            <div>
                <h3 class="font-semibold mb-4">Community</h3>
                <ul class="space-y-2">
                    <li>
                        <a
                            href="/community"
                            class="text-muted-foreground hover:text-white transition-colors"
                            >Join Community</a
                        >
                    </li>
                    <li>
                        <a
                            href="/contributing"
                            class="text-muted-foreground hover:text-white transition-colors"
                            >Contributing</a
                        >
                    </li>
                    <li>
                        <a
                            href="/changelog"
                            class="text-muted-foreground hover:text-white transition-colors"
                            >Changelog</a
                        >
                    </li>
                    <li>
                        <a
                            href="/roadmap"
                            class="text-muted-foreground hover:text-white transition-colors"
                            >Roadmap</a
                        >
                    </li>
                </ul>
            </div>
        </div>
    </div>
</footer>
